<Window x:Class="SentinelIntrusionDetection.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Observa - Intrusion Detection" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                         ShadowDepth="2" 
                         BlurRadius="8" 
                         Opacity="0.15" 
                         Color="#000000"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F62FE" 
                           Width="40" 
                           Height="40" 
                           CornerRadius="8"
                           Margin="0,0,16,0">
                        <TextBlock Text="O" 
                                  FontSize="22" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Observa" 
                                  FontSize="20" 
                                  FontWeight="SemiBold" 
                                  Foreground="#161616"/>
                        <TextBlock Text="Intrusion Detection System" 
                                  FontSize="11" 
                                  Foreground="#6F6F6F"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F4F4F4"
                           CornerRadius="8"
                           Padding="16,8"
                           Margin="0,0,12,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" 
                                      Foreground="#161616" 
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UserEmail}" 
                                      Foreground="#6F6F6F" 
                                      FontSize="11"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>



                    <Button Content="Logout" 
                            Command="{Binding LogoutCommand}"
                            Background="White"
                            Foreground="#DA1E28"
                            Padding="20,10"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            Cursor="Hand"
                            FontWeight="Medium"
                            FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                       CornerRadius="6"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BorderThickness="{TemplateBinding BorderThickness}"
                                       Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF1F1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Frame (Overlay) -->
            <Frame x:Name="MainFrame" 
                   Grid.ColumnSpan="2" 
                   NavigationUIVisibility="Hidden" 
                   Panel.ZIndex="100"
                   Visibility="Collapsed"/>

            <!-- Video Feed -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="8"
                    Margin="0,0,16,0"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <!-- Video Display -->
                    <Image x:Name="VideoFeed"
                           Source="{Binding CurrentFrame}"
                           Stretch="Uniform"
                           Margin="2"
                           Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Placeholder when not monitoring -->
                    <StackPanel VerticalAlignment="Center" 
                               HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#F4F4F4" 
                               Width="120" 
                               Height="120" 
                               CornerRadius="60"
                               Margin="0,0,0,24">
                            <TextBlock Text="📹" 
                                      FontSize="56" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Camera Feed Inactive" 
                                  FontSize="20" 
                                  Foreground="#161616"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Start Monitoring' to begin surveillance" 
                                  FontSize="13" 
                                  Foreground="#6F6F6F"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Recording Indicator -->
                    <Border Background="#DA1E28" 
                           CornerRadius="6"
                           Padding="12,6"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="16"
                           Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,8,0"/>
                            <TextBlock Text="LIVE" 
                                      Foreground="White" 
                                      FontWeight="SemiBold"
                                      FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Control Panel -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="8"
                    Padding="24"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Control Panel" 
                              FontSize="16" 
                              FontWeight="SemiBold" 
                              Foreground="#161616"
                              Margin="0,0,0,24"/>

                    <!-- Detection Settings -->
                    <TextBlock Text="Detection Settings" 
                              FontSize="12" 
                              Foreground="#525252"
                              FontWeight="Medium"
                              Margin="0,0,0,12"/>

                    <Border Background="Gray" 
                           CornerRadius="6" 
                           Padding="16,12"
                           Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox Content="Motion Detection" 
                                     IsChecked="{Binding MotionDetectionEnabled}"
                                     Foreground="#161616"
                                     FontSize="13"
                                    
                                     Margin="0,0,0,10" Checked="CheckBox_Checked"/>

                            <CheckBox Content="Person Detection" 
                                     
                                     IsChecked="{Binding PersonDetectionEnabled}"
                                     Foreground="#161616"
                                     FontSize="13" Checked="CheckBox_Checked"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Button Content="Start Monitoring" 
                            Command="{Binding StartMonitoringCommand}"
                            Height="44"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0F62FE"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0353E9"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Stop Monitoring" 
                            Command="{Binding StopMonitoringCommand}"
                            Height="44"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,0,24">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#DA1E28"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#DA1E28"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF1F1"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>



                    <!-- Detection Logs -->
                    <TextBlock Text="Activity Log" 
                              FontSize="12" 
                              Foreground="#525252"
                              FontWeight="Medium"
                              Margin="0,0,0,12"/>

                    <ListBox ItemsSource="{Binding DetectionLogs}"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Foreground="#161616"
                            Height="140"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" 
                                       BorderBrush="#F4F4F4" 
                                       BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeDisplay}" 
                                                  Foreground="#8D8D8D" 
                                                  FontSize="10"/>
                                        <Border Grid.Column="1" 
                                               Background="#E8F4FD"
                                               CornerRadius="3"
                                               Padding="6,2"
                                               HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Type}" 
                                                      Foreground="#0F62FE"
                                                      FontSize="10"
                                                      FontWeight="Medium"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" 
                                                  Text="{Binding Message}" 
                                                  Foreground="#525252" 
                                                  FontSize="11"
                                                  TextTrimming="CharacterEllipsis"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#8D8D8D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="#24A148"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="#525252" 
                              VerticalAlignment="Center"
                              FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="System Idle"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Text" Value="System Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                          Text="{Binding StatusMessage}" 
                          Foreground="#0F62FE"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          FontSize="12"/>

                <TextBlock Grid.Column="2" 
                          Foreground="#8D8D8D"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Text="{Binding Source={x:Static system:DateTime.Now}, StringFormat='HH:mm:ss'}"
                          xmlns:system="clr-namespace:System;assembly=mscorlib"/>
            </Grid>
        </Border>
    </Grid>
</Window>