<Window x:Class="SentinelIntrusionDetection.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Observa - Login" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Two Column Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side - Branding -->
        <Grid Grid.Column="0" Background="White">
            <StackPanel VerticalAlignment="Center" Margin="60,40">
                <!-- Logo/Icon -->
                <Viewbox Width="100" Height="100" Margin="0,0,0,32">
                    <Canvas Width="100" Height="100">
                        <Ellipse Width="100" Height="100" Stroke="#0F62FE" StrokeThickness="8" Fill="Transparent"/>
                        <Path Data="M 50 20 L 50 80" Stroke="#0F62FE" StrokeThickness="6"/>
                        <Path Data="M 50 30 L 70 50 L 50 70 L 30 50 Z" Fill="#0353E9"/>
                    </Canvas>
                </Viewbox>

                <!-- App Name -->
                <TextBlock Text="Observa" 
                          FontSize="42" 
                          FontWeight="SemiBold" 
                          Foreground="#161616"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,8"/>

                <TextBlock Text="Intrusion Detection System" 
                          FontSize="15" 
                          Foreground="#6F6F6F"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,48"/>

                <!-- Features -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#E8F4FD" 
                               Width="32" 
                               Height="32" 
                               CornerRadius="16"
                               Margin="0,0,16,0">
                            <TextBlock Text="✓" 
                                      Foreground="#0F62FE" 
                                      FontSize="16"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI-Powered Detection" 
                                      Foreground="#161616" 
                                      FontSize="14"
                                      FontWeight="Medium"/>
                            <TextBlock Text="Advanced person identification" 
                                      Foreground="#6F6F6F" 
                                      FontSize="12"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#E8F4FD" 
                               Width="32" 
                               Height="32" 
                               CornerRadius="16"
                               Margin="0,0,16,0">
                            <TextBlock Text="✓" 
                                      Foreground="#0F62FE" 
                                      FontSize="16"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Real-time Monitoring" 
                                      Foreground="#161616" 
                                      FontSize="14"
                                      FontWeight="Medium"/>
                            <TextBlock Text="Instant motion alerts and tracking" 
                                      Foreground="#6F6F6F" 
                                      FontSize="12"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#E8F4FD" 
                               Width="32" 
                               Height="32" 
                               CornerRadius="16"
                               Margin="0,0,16,0">
                            <TextBlock Text="✓" 
                                      Foreground="#0F62FE" 
                                      FontSize="16"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Secure Authentication" 
                                      Foreground="#161616" 
                                      FontSize="14"
                                      FontWeight="Medium"/>
                            <TextBlock Text="OAuth-based access control" 
                                      Foreground="#6F6F6F" 
                                      FontSize="12"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E8F4FD" 
                               Width="32" 
                               Height="32" 
                               CornerRadius="16"
                               Margin="0,0,16,0">
                            <TextBlock Text="✓" 
                                      Foreground="#0F62FE" 
                                      FontSize="16"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Complete Event Logging" 
                                      Foreground="#161616" 
                                      FontSize="14"
                                      FontWeight="Medium"/>
                            <TextBlock Text="Detailed activity records &amp; snapshots" 
                                      Foreground="#6F6F6F" 
                                      FontSize="12"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Right Side - Login Form -->
        <Grid Grid.Column="1" Background="#F5F7FA">
            <Border Background="White" 
                    CornerRadius="12"
                    Padding="48"
                    Margin="60,80"
                    VerticalAlignment="Center"
                    MaxWidth="380">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.08"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Welcome" 
                              FontSize="28" 
                              FontWeight="SemiBold" 
                              Foreground="#161616"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="Sign in to access your surveillance dashboard" 
                              FontSize="13" 
                              Foreground="#6F6F6F"
                              TextWrapping="Wrap"
                              LineHeight="20"
                              Margin="0,0,0,32"/>

                    <!-- Status Message -->
                    <Border Background="#F4F4F4" 
                            CornerRadius="6" 
                            Padding="16,12"
                            Margin="0,0,0,24">
                        <TextBlock Text="{Binding StatusMessage}" 
                                  Foreground="#525252"
                                  TextWrapping="Wrap"
                                  FontSize="12"
                                  LineHeight="18"
                                  TextAlignment="Center"/>
                    </Border>

                    <!-- Login Button -->
                    <Button Content="Sign in with Sentinel" 
                            Command="{Binding LoginCommand}"
                            Height="48"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,0,0,16"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0F62FE"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0353E9"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsAuthenticating}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Loading Indicator -->
                    <ui:ProgressRing IsActive="{Binding IsLoading}"
                                    Width="36"
                                    Height="36"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Divider -->
                    <Border Height="1" 
                           Background="#E0E0E0" 
                           Margin="0,24,0,24"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <!-- Help Text -->
                    <Border Background="#E8F4FD" 
                           CornerRadius="6"
                           Padding="12"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel>
                            <TextBlock Text="🔒 Secure Authentication" 
                                      FontSize="12" 
                                      Foreground="#0F62FE"
                                      FontWeight="Medium"
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="Your browser will open for secure OAuth authentication. This ensures your credentials are never stored in the application." 
                                      FontSize="11" 
                                      Foreground="#525252"
                                      TextWrapping="Wrap"
                                      LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Version Info -->
        <Border Grid.ColumnSpan="2"
               Background="White"
               Padding="20,12"
               VerticalAlignment="Bottom">
            <Grid>
                <TextBlock Text="v1.0.0" 
                          FontSize="11" 
                          Foreground="#8D8D8D"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"/>

                <TextBlock Text="© 2024 Observa Security" 
                          FontSize="11" 
                          Foreground="#8D8D8D"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>